# Settings for docker-compose.yml. Copy to .env - scripts/setup-env.sh does
# that and fills in the three secrets. Never commit .env.

# --- Secrets: long random strings, one each (openssl rand -hex 32).
AUTH_SECRET=
BACKEND_JWT_SECRET=
POSTGRES_PASSWORD=

# --- The address people open. Locally http://localhost:3420; on a server
# the production file sets https://$DOMAIN for you.
AUTH_URL=http://localhost:3420
DOMAIN=

# --- Sign-in emails. Locally, Mailpit catches them (http://localhost:8025).
# On a server, your SMTP provider: smtp://user:password@smtp.example.com:587
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=Job Hunter <no-reply@localhost>

# --- Job sources (docs/job-sources.md), comma-separated: himalayas and
# jobicy (remote jobs, free), demo (built-in sample jobs with fictional
# employers). COMMERCIAL_ONLY=true leaves out any source whose terms don't
# allow use in a paid, hosted product.
JOB_SOURCES=himalayas,jobicy
COMMERCIAL_ONLY=false
# Optional, free from himalayas.app: raises Himalayas' rate limits.
HIMALAYAS_API_KEY=

# --- AI scoring (docs/ai-scoring.md). With no key, a simulated scorer runs:
# free, local, and labelled as simulated everywhere.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low
AI_THINKING=false
AI_AUTO_SCORE=true
AI_SCORES_PER_MONTH=300
AI_BUDGET_USD_PER_MONTH=5

# --- Optional: "Continue with GitHub / Google". Leave empty to hide them.
# Callback URLs: <AUTH_URL>/api/auth/callback/github and .../google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
