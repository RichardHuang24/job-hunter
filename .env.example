# Settings for docker-compose.yml. Copy to .env - scripts/setup-env.sh does
# that and fills in the secrets. Never commit .env.

# --- Secrets: long random strings, one each (openssl rand -hex 32).
AUTH_SECRET=
BACKEND_JWT_SECRET=
POSTGRES_PASSWORD=
# The file storage's keys (the storage service, for CV PDFs).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- The address people open. Locally http://localhost:3420; on a server
# the production file sets https://$DOMAIN for you.
AUTH_URL=http://localhost:3420
DOMAIN=

# --- Sign-in emails. Locally, Mailpit catches them (http://localhost:8025).
# On a server, your SMTP provider: smtp://user:password@smtp.example.com:587
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=Job Hunter <no-reply@localhost>

# --- Job sources (docs/job-sources.md), comma-separated: himalayas and
# jobicy (remote jobs, free), demo (built-in sample jobs with fictional
# employers). COMMERCIAL_ONLY=true leaves out any source whose terms don't
# allow use in a paid, hosted product.
JOB_SOURCES=himalayas,jobicy
COMMERCIAL_ONLY=false
# Optional, free from himalayas.app: raises Himalayas' rate limits.
HIMALAYAS_API_KEY=

# --- AI scoring (docs/ai-scoring.md). With no key, a simulated scorer runs:
# free, local, and labelled as simulated everywhere.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EFFORT=low
AI_THINKING=false
AI_AUTO_SCORE=true
AI_SCORES_PER_MONTH=300
AI_BUDGET_USD_PER_MONTH=5

# --- Optional: "Continue with GitHub / Google". Leave empty to hide them.
# Callback URLs: <AUTH_URL>/api/auth/callback/github and .../google
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional: keep generated files (CV PDFs) in Cloudflare R2, AWS S3 or
# another S3-compatible service instead of the storage service. Leave empty
# to use the storage service.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Privacy (docs/privacy.md): who runs this Job Hunter and how people reach
# you about their data. Shown on the privacy page; fill these in before
# anyone else signs up.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
# Where people can get this copy's source code (AGPL-3.0). Change it if you
# run a modified version.
SOURCE_URL=https://github.com/RichardHuang24/job-hunter

# --- Billing (docs/billing.md). Off: every feature is free - leave it off
# when you host Job Hunter for yourself.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
